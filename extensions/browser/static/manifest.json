{
  "manifest_version": 3,
  "name": "Spend Firewall",
  "short_name": "Spend Firewall",
  "version": "0.1.0",
  "description": "Live AI agent spend, budget alerts and a one-click kill switch for your Spend Firewall gateway.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Spend Firewall", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "spendfirewall@spendfirewall.dev", "strict_min_version": "121.0" } }
}
