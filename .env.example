# Copy to .env and fill in. Only the provider keys you use are needed.
BOOTSTRAP_ADMIN_KEY=sf-change-me-admin-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Uncomment to send all traffic to the bundled fake provider (no cost)
# UPSTREAM_OVERRIDE_BASE_URL=http://mock-provider:9000/v1
FAIL_MODE=closed
LOOP_MAX_REPEATS=5
LOOP_WINDOW_SECONDS=60
DEFAULT_MAX_OUTPUT_TOKENS=4096
